# Database — use sqlite for local dev, postgres for production
DATABASE_URL=sqlite+aiosqlite:///./medprice.db
# PostgreSQL example: DATABASE_URL=postgresql+asyncpg://user:password@host:5432/medprice

# Redis (used by Celery for background tasks)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security — generate a real random secret for production (e.g. openssl rand -hex 32)
SECRET_KEY=replace-with-a-real-random-secret-key-at-least-32-chars

# Environment: development | production | staging
ENVIRONMENT=development

# Scraper tuning
SCRAPING_DELAY_MIN=1.5
SCRAPING_DELAY_MAX=4.0
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# Allowed CORS origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:3000","https://your-frontend.vercel.app"]
